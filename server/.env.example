# Copy this file to .env and fill in your key.
# Never commit the real .env file.

# --- FREE option (default, recommended for a $0 demo): Groq ---
# 1. Create a free account at https://console.groq.com — no credit card needed
# 2. Create an API key (starts with "gsk_") and paste it below
# 3. Paste the key below
GROQ_API_KEY=gsk_your_groq_key_here

# Supabase Credentials (Get from Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Server
PORT=4000

# Whisper / transcription model (Groq's free-tier catalog)
ASR_MODEL=whisper-large-v3-turbo

# LLM used for summarization (Groq's free-tier catalog)
SUMMARY_MODEL=llama-3.3-70b-versatile

